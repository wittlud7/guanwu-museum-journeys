<view class="screen">
 <view class="top"><view class="wordmark"><text class="seal">观</text><text>观物</text><text class="roman">GUANWU</text></view><button data-modal="city" bindtap="openModal">⌖ {{city}}⌄</button></view>
 <block wx:if="{{view==='discover'}}">
  <view class="eyebrow">A LITTLE CURIOSITY, A BIGGER WORLD</view><view class="heading">让好奇心，带你远行</view><view class="subtitle">走进一座博物馆，读懂一方水土。</view>
  <view class="hero" bindtap="openRoute"><image src="/assets/great-wall.jpg" mode="aspectFill"/><view class="shade"/><view class="hero-copy"><view class="kicker">— 本期精选 · 山河之间</view><view class="hero-title">山河入眼，<text>{{'\n'}}</text>文物入心。</view><view class="hero-sub">从一处风景开始，<text>{{'\n'}}</text>重新认识脚下的土地。</view><view class="hero-cta">开启这段旅程　→</view></view><view class="hero-foot">中国 · 长城 / THE GREAT WALL</view></view>
  <view class="shortcuts"><button data-tab="collection" bindtap="navigate"><text>⌂ 博物馆藏</text><text class="tiny">时间里的珍藏</text></button><button data-tab="journeys" bindtap="navigate"><text>⌘ 山河漫游</text><text class="tiny">土地上的故事</text></button><button bindtap="daily"><text>◈ 每日一物</text><text class="tiny">与一件好物相遇</text></button><button data-modal="member" bindtap="openModal"><text>♡ 深度赏读</text><text class="tiny">把美看得更深</text></button></view>
  <view class="section-title"><text>值得驻足</text><text class="en">CURATED COLLECTIONS</text></view>
 </block>
 <block wx:if="{{view==='collection'}}"><view class="eyebrow">THE COLLECTIONS</view><view class="heading">在器物里，与时间相逢</view><view class="subtitle">大都会艺术博物馆 · 中国艺术开放馆藏</view><input class="search" value="{{query}}" bindinput="search" placeholder="搜索文物、朝代、材质…" confirm-type="search"/></block>
 <block wx:if="{{view==='saved'}}"><view class="eyebrow">YOUR LITTLE MUSEUM</view><view class="heading">收藏每一次心动</view><view class="subtitle">喜欢的器物、想去的远方，都在这里等你。</view></block>
 <block wx:if="{{view==='discover'||view==='collection'||view==='saved'}}">
  <view class="filters" wx:if="{{view!=='saved'}}"><button wx:for="{{filters}}" wx:key="*this" class="{{filter===item?'selected':''}}" data-value="{{item}}" bindtap="setFilter">{{item}}</button></view>
  <view class="cards"><view class="card" wx:for="{{items}}" wx:key="id"><view class="picture"><image src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openDetail"/><text class="badge">{{item.tag}}</text><button class="heart {{item.saved?'filled':''}}" data-id="{{item.id}}" bindtap="save" aria-label="收藏或取消收藏">{{item.saved?'♥':'♡'}}</button></view><view class="card-title" data-id="{{item.id}}" bindtap="openDetail">{{item.title}}</view><view class="meta">{{item.period}}</view><view class="museum">大都会艺术博物馆</view></view></view>
  <view class="empty" wx:if="{{!items.length}}"><view>{{view==='saved'?'你的私人小馆，等待第一件收藏':'暂时没有找到这件藏品'}}</view><text>不妨从一件青铜器或瓷器开始。</text><button class="solid" data-tab="collection" bindtap="navigate">浏览全部馆藏 →</button></view>
 </block>
 <block wx:if="{{view==='journeys'||(view==='saved'&&activeRoute)||view==='discover'}}">
  <view class="section-title"><text>{{view==='saved'?'我的行程':'把风景读成故事'}}</text></view><view wx:if="{{view==='journeys'}}" class="subtitle">北京 · 人文景观漫游 · 按自己的节奏慢慢走</view>
  <view class="journey" bindtap="openRoute"><image src="/assets/great-wall.jpg" mode="aspectFill"/><view class="shade"/><view class="journey-copy"><text class="kicker">BEIJING · 北京</text><view>循着山脊，读一段长城</view><text class="tiny">3 个观察停靠点 {{activeRoute?'· 已加入行程':'→'}}</text></view></view>
  <view class="editorial" wx:if="{{view!=='saved'}}" data-modal="looking" bindtap="openModal"><view class="eyebrow">THE ART OF LOOKING</view><view>不必急着看完，<text>{{'\n'}}</text>试着真正看见。</view><text class="subtitle">从一条纹样、一抹釉色开始。</text><text class="read-more">写给第一次走进博物馆的你　↗</text></view>
 </block>
 <block wx:if="{{view==='detail'}}"><button class="back" bindtap="back">← 返回{{tab==='saved'?'我的收藏':'馆藏'}}</button><image class="detail-image" src="{{detail.image}}" mode="aspectFit"/><view class="eyebrow">A CLOSER LOOK · {{detail.type}}</view><view class="heading">{{detail.title}}</view><view class="intro">{{detail.intro}}</view><view class="facts"><view><text class="tiny">年代</text>{{detail.period}}</view><view><text class="tiny">材质</text>{{detail.material}}</view><view><text class="tiny">收藏机构</text>大都会艺术博物馆 · 纽约</view><view><text class="tiny">阅读时长</text>{{detail.time}}</view></view><button class="solid" data-id="{{detail.id}}" bindtap="save">{{detail.saved?'♥ 已收藏':'♡ 收藏这件文物'}}</button><view class="article-title">看见器物背后的故事</view><view class="article">{{detail.body}}</view><view wx:if="{{detail.tag==='深度解读'&&!member}}" class="locked"><view class="article-title">再靠近一点，看见更多</view><view class="subtitle">免费阅读简介，解锁完整的观察提示。</view><button class="solid" data-modal="member" bindtap="openModal">体验完整赏读 →</button></view><block wx:else><view class="article-title">不妨这样看</view><view class="article">{{detail.look}}</view></block><button class="source-link" bindtap="showSource">复制馆方原始资料链接 ↗</button><view class="note">图片：The Metropolitan Museum of Art Open Access · 公共领域。基础信息参考馆方资料，观察提示为原创编辑内容。藏品位于纽约，参观信息请以馆方为准。</view></block>
 <block wx:if="{{view==='route'}}"><button class="back" bindtap="back">← 返回山河漫游</button><view class="eyebrow">BEIJING · FIELD NOTES</view><view class="heading">循着山脊，读一段长城</view><view class="subtitle">中国 · 北京 | 文化景观漫游手记</view><image class="route-image" src="/assets/great-wall.jpg" mode="aspectFill"/><view class="stop"><text class="tiny">01 / 出发前</text><view class="article-title">从整体，看见山势</view><view class="article">长城在1987年被列入《世界遗产名录》。它是跨越地域与时代的防御系统。登临前，先观察城墙如何依山而行，想一想山地怎样成为防御的一部分。</view></view><view class="stop"><text class="tiny">02 / 驻足时</text><view class="article-title">从细部，读懂建造</view><view class="article">留意砖石、墙体起伏与敌台的位置。用眼睛比较不同位置的结构。请勿攀爬未开放段，不触碰或带走遗存。</view></view><view class="stop"><text class="tiny">03 / 回望处</text><view class="article-title">让风景，留在记忆里</view><view class="article">在安全的开放区域，回望走过的方向。拍一张远景，再记下一处吸引你的细节，让漫游留下属于自己的观察。</view></view><view class="locked"><view class="article-title">把旅途交给从容</view><view class="subtitle">这是观察手记，不是实时导航。出发前核实官方景区的开放时间、天气与预约要求，穿防滑鞋，备好饮水。</view><button class="solid" bindtap="toggleRoute">{{activeRoute?'✓ 已加入行程 · 点击移除':'＋ 加入我的行程'}}</button></view><view class="note">资料来源：UNESCO 世界遗产中心，whc.unesco.org/en/list/438/。图片为长城主题摄影，不代表具体入口。</view></block>
 <view class="footer"><text>观物 GUANWU</text><button data-modal="about" bindtap="openModal">关于观物与图片来源 ↗</button></view>
</view>
<view class="bottom-nav"><button class="{{tab==='discover'?'active':''}}" data-tab="discover" bindtap="navigate"><text class="nav-icon">◉</text>发现</button><button class="{{tab==='collection'?'active':''}}" data-tab="collection" bindtap="navigate"><text class="nav-icon">⌂</text>博物馆藏</button><button class="{{tab==='journeys'?'active':''}}" data-tab="journeys" bindtap="navigate"><text class="nav-icon">⌘</text>山河漫游</button><button class="{{tab==='saved'?'active':''}}" data-tab="saved" bindtap="navigate"><text class="nav-icon">♡</text>我的收藏</button></view>
<view wx:if="{{modal}}" class="modal-mask" bindtap="closeModal"><view class="modal" catchtap="stop"><button class="close" bindtap="closeModal">×</button><block wx:if="{{modal==='member'}}"><view class="eyebrow">GUANWU · MEMBERSHIP</view><view class="heading">让好奇，走得更远</view><view class="article">完整阅读馆藏观察提示，收藏心爱的器物，收下沿途的人文漫游手记。</view><view class="price">免费体验</view><view class="note">付费尚未开放。本次解锁仅演示会员流程，不扣款，权益仅保存在当前设备。</view><button class="solid" bindtap="unlock">{{member?'已解锁 · 继续探索':'免费体验完整赏读 →'}}</button></block><block wx:if="{{modal==='city'}}"><view class="heading">下一站，去哪里？</view><button class="city" wx:for="{{cities}}" wx:key="*this" data-city="{{item}}" bindtap="selectCity">{{item}}　→</button><view class="note">北京：长城漫游手记。纽约：大都会中国艺术馆藏。</view></block><block wx:if="{{modal==='looking'}}"><view class="eyebrow">THE ART OF LOOKING</view><view class="heading">给第一次看展的你</view><view class="article">选择一件令你停下来的器物。

先看轮廓，再看材料。留意光线如何落在它的表面，寻找重复的纹样。最后读标签，用信息回答自己的问题。

离开时，带走一个新问题，就已经是一场很好的参观。</view></block><block wx:if="{{modal==='about'}}"><view class="heading">以好奇，连接世界</view><view class="article">观物首版收录4件真实开放馆藏与1份长城主题漫游手记。

馆藏图像来自 The Met Open Access，下载时已核实为公共领域；长城摄影来自 Unsplash。藏品详情可复制馆方来源。

当前为访客体验，收藏和会员状态仅保存在设备本地，未接入真实支付。</view></block></view></view>
