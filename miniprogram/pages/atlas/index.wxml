<view class="atlas {{audio.owner?'with-audio':''}}"><view class="top"><view class="wordmark"><text class="seal">观</text>观物<text class="roman">GUANWU</text></view><button bindtap="chooseCity">⌖ {{city==='全部'?'全部目的地':city}}⌄</button></view>
 <view class="eyebrow">LIVING HERITAGE, LIVING CITIES</view><view class="heading">{{tab==='discover'?'把一座城，慢慢看懂':tab==='collection'?'把博物馆，装进行囊':tab==='journeys'?'给一座城，多一点时间':'收藏每一次心动'}}</view><view class="subtitle">{{tab==='saved'?'喜欢的手艺、想去的场馆，与自己的观看手记。':'从一件文物、一门手艺开始，读懂城市的时间。'}}</view>
 <block wx:if="{{tab==='discover'}}"><swiper class="hero-swiper" indicator-dots indicator-color="#ffffff50" indicator-active-color="#ffffff"><swiper-item wx:for="{{allMuseums}}" wx:key="id"><view class="hero" data-id="{{item.id}}" bindtap="openMuseum"><image src="{{item.image}}" mode="aspectFill"/><view class="shade"/><view class="hero-copy"><text>城市非遗计划 · {{item.city}}站</text><view>一座城，<text>{{'\n'}}</text>一双手的记忆。</view><text>{{item.name}}</text><view class="hero-cta">走近这座馆　→</view></view></view></swiper-item></swiper><view class="section-title">这一站，去哪里</view></block>
 <view wx:if="{{tab!=='saved'}}" class="cities"><button wx:for="{{cities}}" wx:key="*this" class="{{city===item?'selected':''}}" data-city="{{item}}" bindtap="city">{{item}}</button></view>
 <block wx:if="{{tab==='collection'}}"><input class="search" value="{{query}}" bindinput="search" placeholder="搜索城市、场馆或手艺…" confirm-type="search"/><view class="categories"><button wx:for="{{categories}}" wx:key="*this" class="{{category===item?'active':''}}" data-category="{{item}}" bindtap="filter">{{item}}</button></view></block>
 <block wx:if="{{tab==='saved'}}"><view class="stats"><view wx:for="{{stats}}" wx:key="label"><text>{{item.n}}</text><text>{{item.label}}</text></view></view><view class="section-title">我的行程</view><view class="empty" wx:if="{{!planItems.length}}">还没有安排下一站。去城市漫游选一座场馆吧。</view><view class="plan" wx:for="{{planItems}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openMuseum"/><view><text class="tiny">{{item.city}} · {{item.kind}}</text><view class="plan-title" data-id="{{item.id}}" bindtap="openMuseum">{{item.name}}</view><picker mode="date" value="{{item.date}}" data-id="{{item.id}}" bindchange="date"><view class="date">{{item.date||'＋ 选择计划日期'}}</view></picker></view><view class="plan-actions"><button data-id="{{item.id}}" data-delta="-1" disabled="{{index===0}}" bindtap="move">↑</button><button data-id="{{item.id}}" data-delta="1" disabled="{{index===planItems.length-1}}" bindtap="move">↓</button><button data-id="{{item.id}}" bindtap="plan">×</button></view></view><button class="text-link" wx:if="{{planItems.length}}" bindtap="copyPlan">复制行程清单 ↗</button><view class="section-title">收藏的场馆与手艺</view></block>
 <block wx:if="{{tab==='journeys'}}"><button wx:if="{{journeyCity}}" class="text-link" bindtap="backCities">← 返回城市选择</button><view wx:else class="native-city-grid"><view class="native-city-card" wx:for="{{cityDestinations}}" wx:key="city" data-city="{{item.city}}" bindtap="openCity"><image src="{{item.image}}" mode="aspectFill"/><view><text>{{item.city}}</text><text>{{item.count}} 家博物馆可选 →</text></view><text class="tiny">{{item.names}}</text></view></view><view class="subtitle">{{journeyCity?'选中感兴趣的馆，加入想去清单；再核对馆区、开放与预约。':'先选一座城市，再从三家博物馆里挑选。'}}</view></block>
 <view wx:if="{{tab!=='journeys'||journeyCity}}" class="museum-grid {{tab==='journeys'?'journey-grid':''}}"><view class="museum-card" wx:for="{{museumItems}}" wx:key="id"><view class="museum-cover"><image src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openMuseum"/><text class="badge">{{item.kind}}</text><button class="heart {{item.saved?'filled':''}}" data-key="museum:{{item.id}}" bindtap="save">{{item.saved?'♥':'♡'}}</button><text class="city-label">{{item.roman}} · {{item.city}}</text></view><view class="museum-copy"><view data-id="{{item.id}}" bindtap="openMuseum">{{item.name}}</view><text>{{item.theme}}</text><view class="museum-foot"><text>{{item.chapters[0].audio===false?'3 章阅读手记':'◉ 3 章语音导览'}}</text><button wx:if="{{tab==='journeys'}}" data-id="{{item.id}}" bindtap="plan">{{item.planned?'✓ 已在行程':'＋ 想去'}}</button></view></view></view></view>
 <block wx:if="{{tab!=='journeys'}}"><view class="section-title" wx:if="{{tab!=='saved'}}">文物与手艺的微小宇宙</view><view class="craft-grid"><view class="craft-card" wx:for="{{craftItems}}" wx:key="id"><view class="craft-cover"><image src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openCraft"/><text class="badge">{{item.city}} · {{item.category}}</text><button class="heart {{item.saved?'filled':''}}" data-key="craft:{{item.id}}" bindtap="save">{{item.saved?'♥':'♡'}}</button></view><view class="craft-title" data-id="{{item.id}}" bindtap="openCraft">{{item.title}}</view><text class="tiny">{{item.intro}}</text><text class="image-kind">{{item.label}}</text></view></view></block>
 <view class="empty" wx:if="{{!museumItems.length && !craftItems.length && tab!=='saved'}}">暂时没有找到这段故事，试试其他城市或关键词。</view>
 <block wx:if="{{tab==='saved'}}"><view class="section-title">观看手记</view><view wx:if="{{!notes.length}}" class="empty">在场馆或手艺详情，留下一句自己的发现。</view><view wx:for="{{notes}}" wx:key="key" class="journal-note"><view data-museum="{{item.museum}}" data-craft="{{item.craft}}" bindtap="openNote">{{item.title}} ↗</view><text>{{item.text}}</text><button class="text-link" data-key="{{item.key}}" bindtap="deleteNote">删除手记</button></view><view class="section-title">知识印记</view><view class="stamps"><button wx:for="{{stamps}}" wx:key="id" class="{{item.earned?'earned':''}}" data-id="{{item.id}}" bindtap="openCraft"><text>◈</text><text>{{item.title}}</text><text>{{item.earned?'已认识':'待相遇'}}</text></button></view><text class="tiny">知识印记记录答题完成情况，不代表实地到访认证。</text></block>
 <view class="editorial" wx:if="{{tab==='discover'||tab==='journeys'}}"><view class="eyebrow">THE ART OF LOOKING</view><view>不必急着看完，<text>{{'\n'}}</text>试着真正看见。</view><text>放大一处纹样，听一个故事，记下自己的发现。</text></view><view class="footer"><text>观物 GUANWU</text><button bindtap="about">关于观物与影像来源 ↗</button></view></view>
<view class="mini-audio" wx:if="{{audio.owner}}"><view bindtap="resumeGuide"><view>{{audio.owner.title}}</view><text>{{audio.title}} · AI 合成</text></view><button bindtap="toggleAudio">{{audio.playing?'Ⅱ':'▷'}}</button><button bindtap="closeAudio">×</button></view>
<view class="bottom-nav"><button data-tab="discover" bindtap="tab" class="{{tab==='discover'?'active':''}}"><text>◉</text>发现</button><button data-tab="collection" bindtap="tab" class="{{tab==='collection'?'active':''}}"><text>⌂</text>博物馆</button><button data-tab="journeys" bindtap="tab" class="{{tab==='journeys'?'active':''}}"><text>⌘</text>城市漫游</button><button data-tab="saved" bindtap="tab" class="{{tab==='saved'?'active':''}}"><text>♡</text>我的手记</button></view>
<view wx:if="{{modal}}" class="modal-mask" bindtap="closeModal"><view class="modal" catchtap="stop"><button class="close" bindtap="closeModal">×</button><block wx:if="{{modal==='city'}}"><view class="heading">下一站，去哪里？</view><scroll-view scroll-y class="native-city-picker"><button wx:for="{{cities}}" wx:key="*this" data-city="{{item}}" bindtap="chooseCityItem">{{item==='全部'?'全部目的地':item}} <text>→</text></button></scroll-view></block><block wx:else><view class="heading">看见手艺，听见城市</view><view class="article">覆盖11城33馆、18件文物与8个工艺专题。每城至少3馆，新增22馆带具体观察点和官方来源；原有5馆含语音，其余提供阅读导览。跨馆对看和观物卡可在浏览器小程序预览中体验。<text>{{'\n\n'}}</text>语音为AI合成普通话，非真人录音、馆方讲解或真实戏曲唱段。<text>{{'\n\n'}}</text>场馆实拍和工艺参照图分别标注；详情页可查看作者、许可，并复制原始来源链接。<text>{{'\n\n'}}</text>会员为免费体验演示，不扣款。收藏、手记、行程只在当前设备保存。</view></block></view></view>
