.guide-screen{padding:35rpx 40rpx 60rpx}.guide-screen.with-audio{padding-bottom:315rpx}.eyebrow{font:16rpx sans-serif;letter-spacing:4rpx;color:#97a58a;margin:15rpx 0}.heading{font:47rpx/1.65 serif;margin:15rpx 0;letter-spacing:2rpx}.subtitle{font-size:23rpx;line-height:1.9;color:#899b7a;margin:15rpx 0 25rpx}.cover{width:100%;height:540rpx;border-radius:8rpx;background:#e7e4d9;margin-top:30rpx}.cover.contain{height:700rpx}.photo-strip{white-space:nowrap;width:100%;margin:20rpx 0;height:145rpx}.photo-strip image{display:inline-block;width:150rpx;height:140rpx;margin-right:15rpx;border-radius:5rpx}.photo-note{font-size:18rpx;color:#a0ad91;line-height:1.9}.photo-note text{text-decoration:underline}.visit-box,.note-box{background:#e9eddf;border-radius:8rpx;padding:35rpx;margin:35rpx 0}.section-title{font:36rpx/1.8 serif;margin:40rpx 0 25rpx}.visit-box .section-title,.note-box .section-title{margin-top:0}.article{font:27rpx/2.15 serif;color:#7c906d;white-space:pre-wrap}.address{font-size:22rpx;line-height:1.9;border-top:1rpx solid #d3dfc7;padding-top:30rpx;margin-top:30rpx}.solid{padding:25rpx;background:#344e41;color:#fafbf5;border-radius:5rpx;margin:25rpx 0 0;font-size:24rpx}.outline{border:1rpx solid #cbdabb;border-radius:5rpx;padding:23rpx;font-size:23rpx;margin-top:25rpx}.button-row{display:flex;gap:18rpx}.button-row button{flex:1}.source-link{font-size:21rpx;text-align:left;text-decoration:underline;line-height:2;margin:25rpx 0 0}.note{font-size:19rpx;color:#9ba88a;line-height:1.95;margin:20rpx 0}.chapter{display:flex;align-items:center;gap:24rpx;border:1rpx solid #dbe4ce;padding:27rpx 24rpx;border-radius:5rpx;margin:16rpx 0;text-align:left;font:26rpx/1.8 serif}.chapter>view{flex:1}.chapter-number{font:40rpx serif;color:#b0bfa0}.chapter.playing{background:#e2ebd7}.tiny{display:block;font:17rpx/1.8 sans-serif;color:#97a98a;margin-top:8rpx}.related-grid{display:flex;flex-wrap:wrap;gap:30rpx}.related{width:calc(50% - 15rpx)}.related image{width:100%;height:365rpx;border-radius:6rpx}.related>view{font:28rpx/1.8 serif;margin-top:18rpx}.tips{font-size:24rpx;margin:15rpx 0}.step{display:flex;gap:25rpx;border-bottom:1rpx solid #dce5d1;padding:26rpx 0;font-size:24rpx;line-height:1.95;color:#889b76}.step>text{font:34rpx serif;color:#a0b18d}.step>view{flex:1}.quiz-invite{background:#e8edde;border-radius:6rpx;padding:30rpx 20rpx;font:25rpx/1.9 serif;margin:35rpx 0}.note-box textarea{box-sizing:border-box;width:100%;height:240rpx;padding:25rpx;border:1rpx solid #d2ddc6;background:#f8faf3;font-size:27rpx;line-height:1.9;border-radius:5rpx}.footer-note{font-size:18rpx;color:#a6b197;line-height:2;margin-top:40rpx}.back{font-size:22rpx;color:#8e9f7c;text-align:left;margin-bottom:35rpx}.audio-panel{position:fixed;z-index:15;bottom:0;left:0;right:0;background:#f1f5e9;border-top:1rpx solid #d2dfc5;padding:22rpx 35rpx calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -5rpx 25rpx #23362b10}.audio-top{display:flex;align-items:center;gap:28rpx}.audio-top>view{flex:1;min-width:0;font:25rpx/1.8 serif}.audio-top>view>view{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.audio-top>button{font-size:39rpx;padding:8rpx 12rpx;margin:0}.audio-range{display:flex;align-items:center;gap:15rpx;margin-top:8rpx;font-size:18rpx;color:#8b9f79}.audio-range slider{flex:1;margin:8rpx}.audio-tools{display:flex;align-items:center;justify-content:space-between;gap:15rpx;font-size:19rpx;margin-top:12rpx}.audio-tools button{font-size:19rpx;margin:0;padding:6rpx}.modal-mask{position:fixed;z-index:30;inset:0;background:#1c3023a0;display:flex;align-items:center;justify-content:center;padding:35rpx}.modal{background:#f7f7f2;position:relative;border-radius:15rpx;padding:50rpx 40rpx;width:100%;max-height:78vh;overflow:auto}.modal .heading{font-size:43rpx}.close{position:absolute;right:20rpx;top:10rpx;font-size:48rpx;color:#9ba88d}.answer{padding:25rpx;border:1rpx solid #d4e0c6;border-radius:5rpx;margin-top:20rpx;text-align:left;font-size:25rpx;line-height:1.9}.feedback{padding:25rpx;background:#e4edda;border-radius:6rpx;font-size:24rpx;line-height:1.9;margin-top:25rpx}.credit{border-bottom:1rpx solid #dce4d1;padding:25rpx 0;font-size:23rpx;line-height:1.9}.credit>text{display:block;font-size:18rpx;color:#94a780;overflow-wrap:anywhere}.credit button{font-size:19rpx;text-align:left;text-decoration:underline;margin:15rpx 0 0}

