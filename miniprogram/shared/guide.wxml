<view class="guide-screen {{audio.owner?'with-audio':''}}">
 <button wx:if="{{view==='craft'}}" class="back" bindtap="backMuseum">← 返回 {{museum.name}}</button>
 <view class="eyebrow">{{museum.roman}} · {{view==='museum'?museum.kind:craft.category}}</view><view class="heading">{{view==='museum'?museum.name:craft.title}}</view><view class="subtitle">{{view==='museum'?museum.quote:craft.intro}}</view>
 <image class="cover {{view==='craft'?'contain':''}}" src="{{prefix}}{{view==='museum'?museum.cover:craft.cover}}.jpg" mode="{{view==='craft'?'aspectFit':'aspectFill'}}" data-index="0" bindtap="preview"/>
 <scroll-view scroll-x class="photo-strip"><image wx:for="{{gallery}}" wx:key="key" src="{{item.src}}" mode="aspectFill" data-index="{{index}}" bindtap="preview"/></scroll-view><view class="photo-note">{{view==='museum'?'图片含场馆与工艺资料，逐图标注':'工艺影像与观察提示'}} · <text bindtap="showCredits">查看摄影署名与许可 ↗</text></view>
 <view class="visit-box" wx:if="{{view==='museum'}}"><view class="section-title">{{museum.theme}}</view><view class="article">{{museum.intro}}</view><view class="address">⌖ {{museum.address}}</view><view class="subtitle">{{museum.duration}} · 3 章普通话导览</view><button class="solid" data-index="0" bindtap="play">▷ 听一听这座馆</button><view class="button-row"><button class="outline" bindtap="toggleSave">{{saved?'♥ 已收藏':'♡ 收藏场馆'}}</button><button class="outline" bindtap="togglePlan">{{planned?'✓ 已在行程':'＋ 加入行程'}}</button></view><button class="source-link" bindtap="copySource">复制参观信息来源 ↗</button><view class="note">开放、预约及展演以馆方当日公告为准。停留时长为编辑建议。</view></view>
 <block wx:if="{{view==='museum'}}"><view class="section-title">让故事，在耳边展开</view><view class="note">AI 合成普通话 · 非真人录音或戏曲唱段</view><button class="chapter {{audio.owner.id==='museum:'+museum.id &amp;&amp; audio.index===index &amp;&amp; audio.playing?'playing':''}}" wx:for="{{chapters}}" wx:key="index" data-index="{{index}}" bindtap="play"><text class="chapter-number">0{{index+1}}</text><view><view>{{item.title}}</view><text class="tiny">{{index===0?'免费试听':member?'已解锁 · 完整导览':'完整导览 · 免费体验解锁'}}</text></view><text>{{index>0 &amp;&amp; !member?'◇':'▷'}}</text></button><view class="section-title">先认一门手艺</view><view class="related-grid"><view wx:for="{{related}}" wx:key="id" class="related" data-id="{{item.id}}" bindtap="openCraft"><image src="{{item.image}}" mode="aspectFill"/><view>{{item.title}}</view><text class="tiny">{{item.label}}</text></view></view><view class="section-title">出发前的一点准备</view><view class="article tips" wx:for="{{museum.tips}}" wx:key="*this">· {{item}}</view><view class="section-title">资料与延伸</view><button class="source-link" wx:for="{{museum.sources}}" wx:key="url" data-url="{{item.url}}" bindtap="copySource">{{item.title}} · 复制链接 ↗</button></block>
 <block wx:else><view class="button-row"><button class="solid" data-index="0" bindtap="play">▷ 听工艺讲解</button><button class="outline" bindtap="toggleSave">{{saved?'♥ 已收藏':'♡ 收藏手艺'}}</button></view><view class="article">{{craft.body}}</view><view class="section-title">不妨这样看</view><view class="article">{{craft.look}}</view><view class="section-title">把工艺拆成三步</view><view class="step" wx:for="{{craft.steps}}" wx:key="*this"><text>0{{index+1}}</text><view>{{item}}</view></view><button class="quiz-invite" data-id="{{craft.id}}" bindtap="openQuiz">◈ 认一门手艺，收下知识印记 →</button><button class="source-link" bindtap="copySource">{{craft.source.title}} · 复制资料链接 ↗</button></block>
 <view class="note-box"><view class="section-title">留一句自己的发现</view><textarea value="{{note}}" bindinput="noteInput" maxlength="800" placeholder="今天留住你的，是一条线、一种颜色，还是一个声音？"/><view class="note">保存在当前设备 · 最多 800 字</view><button class="solid" bindtap="saveNote">保存手记 →</button></view><view class="footer-note">观物原创观察提示，不代表馆方讲解。首批资料核对：2026-10-22。</view>
</view>
<view class="audio-panel" wx:if="{{audio.owner}}"><view class="audio-top"><view><view>{{audio.owner.title}}</view><text class="tiny">{{audio.title}} · AI 合成</text></view><button bindtap="toggleAudio">{{audio.playing?'Ⅱ':'▷'}}</button><button bindtap="closeAudio">×</button></view><view class="audio-range"><text>{{elapsed}}</text><slider min="0" max="{{audio.duration>0?audio.duration:100}}" value="{{audio.time}}" step="0.1" activeColor="#6c8656" block-size="14" bindchange="seek"/><text>{{total}}</text></view><view class="audio-tools"><button data-delta="-15" bindtap="skip">↶ 15秒</button><picker range="{{rates}}" value="{{rateIndex}}" bindchange="changeRate"><view>{{audio.rate}}× 倍速</view></picker><button bindtap="showTranscript">文稿</button><button wx:if="{{audio.owner.id==='museum:'+museum.id &amp;&amp; audio.index<2}}" bindtap="nextChapter">下一章 →</button></view></view>
<view wx:if="{{modal}}" class="modal-mask" bindtap="closeModal"><view class="modal" catchtap="stop"><button class="close" bindtap="closeModal">×</button><block wx:if="{{modal==='member'}}"><view class="eyebrow">DEEPER STORIES</view><view class="heading">让好奇，走得更远</view><view class="article">免费体验完整的15章场馆导览与文稿。语音与图片随城市分包保存，下载完成后无需调用在线语音服务。</view><view class="note">不扣款。本地解锁仅演示权益流程，真实收费尚未接入。</view><button class="solid" bindtap="unlock">免费体验全部导览 →</button></block><block wx:if="{{modal==='transcript'}}"><view class="heading">导览文稿</view><view class="article">{{transcript}}</view><view class="note">AI 合成普通话导览，非真人录音或戏曲唱段。</view></block><block wx:if="{{modal==='quiz'}}"><view class="eyebrow">A LITTLE CURIOSITY</view><view class="heading">认一门手艺</view><view class="article">{{quiz.quiz.question}}</view><button class="answer" wx:for="{{answers}}" wx:key="index" data-index="{{index}}" disabled="{{correct}}" bindtap="answer">{{item.text}}</button><view class="feedback" wx:if="{{quizResult}}">{{quizResult}}</view><view class="note">知识印记记录学习完成情况，不代表实地到访。</view></block><block wx:if="{{modal==='credits'}}"><view class="heading">影像都有来处</view><view class="credit" wx:for="{{creditRows}}" wx:key="url"><view>{{item.caption}}</view><text>{{item.author}} · {{item.license}}</text><view class="button-row"><button data-url="{{item.url}}" bindtap="copySource">复制原始来源</button><button data-url="{{item.licenseUrl}}" bindtap="copySource">复制许可链接</button></view></view><view class="note">图片经缩放，界面可能裁切，照片沿用原许可。</view></block></view></view>
