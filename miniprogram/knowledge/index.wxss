page{background:#f7f7f2;color:#3d4439}.page{padding:40rpx 30rpx 80rpx}.eyebrow{font-size:20rpx;color:#988267;letter-spacing:4rpx}.title{font:60rpx/1.6 serif;margin:22rpx 0}.sub{font-size:23rpx;color:#807663}.tabs{display:flex;gap:12rpx;margin:40rpx 0}.tabs button{font-size:22rpx;padding:12rpx;background:#eae5da;line-height:2;flex:1;border-radius:0}.tabs button:after,button:after{border:none}.cards{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.card{border:1rpx solid #d9d0c0;padding:22rpx;margin-top:24rpx;min-width:0}.card image{width:100%;height:230rpx;background:#ebe5d9}.placeholder{height:230rpx;background:#ebe5d9;color:#9b8a72;display:flex;align-items:center;justify-content:center;font:30rpx serif;text-align:center}.name{font:35rpx/1.6 serif;margin:16rpx 0}.body{display:block;font-size:24rpx;line-height:1.9;color:#70685d;margin:14rpx 0}.tiny{display:block;font-size:20rpx;line-height:1.8;color:#95866f;overflow-wrap:anywhere}.link{font-size:22rpx;color:#8e6740;text-align:left;background:none;padding:12rpx 0;margin:0;line-height:1.8;white-space:normal}.outline{border:1rpx solid #b3a38a;background:none;font-size:24rpx;line-height:2;padding:12rpx;margin:24rpx 0;border-radius:0}.notice{background:#eae5da;padding:28rpx;font-size:26rpx;line-height:1.9;margin:36rpx 0}.hero{width:100%;height:500rpx;background:#ebe5d9}.no-photo{padding:100rpx 20rpx;background:#eae5da;text-align:center;color:#95866f}.field{display:grid;grid-template-columns:170rpx 1fr;gap:20rpx;padding:24rpx 0;border-top:1rpx solid #ded4c3;font-size:24rpx;line-height:1.8}.label{color:#95866f;font-size:22rpx}.reading{padding:30rpx 0;border-top:1rpx solid #ded4c3}.comparison{padding:24rpx 0;border-top:1rpx solid #ded4c3}.comparison>view:last-child,.compare-head{display:grid;grid-template-columns:1fr 1fr;gap:26rpx}.comparison text{font-size:23rpx;line-height:1.9;overflow-wrap:anywhere}.compare-head>view{min-width:0}input{padding:26rpx;border:1rpx solid #d9d0c0;font-size:25rpx;margin-bottom:22rpx}

.native-viewer{width:100%;height:600rpx}.viewer-controls{display:flex;gap:10rpx}.viewer-controls button{background:#faf6ed;border-radius:0;font-size:24rpx;padding:12rpx;line-height:2;flex:1}
